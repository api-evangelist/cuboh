            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v2/external-integration/merchant/:external_integration_merchant_uuid/item/status-update", "host": ["{{baseUrl}}"], "path": ["api", "v2", "external-integration", "merchant", ":external_integration_merchant_uuid", "item", "status-update"], "variable": [{ "key": "external_integration_merchant_uuid", "value": "" }] },
